# Which LLM backend to use: "gemini" (default, free tier) or "anthropic" (Claude)
LLM_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com/apikey — no card required)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (optional — only needed if LLM_PROVIDER=anthropic; requires
# a funded Anthropic Console account, see https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5
